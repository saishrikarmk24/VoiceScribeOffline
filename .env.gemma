# ---------------------------------------------------------------------------
# VoiceScribe AI - 100% Local Offline Environment (Gemma Edition)
# Powered by Google Gemma 2 & AI4Bharat IndicWhisper
# ---------------------------------------------------------------------------

# --- AI Provider (Local Gemma via Ollama) -----------------------------------
AI_MODE=local
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gemma2:9b
LOCAL_LLM_TIMEOUT_SECONDS=180
LOCAL_LLM_MAX_RETRIES=2
LOCAL_LLM_TEMPERATURE=0.05
LOCAL_LLM_NUM_CTX=2048
LOCAL_LLM_MAX_TOKENS=600

# Fallback cloud key (optional, not used when AI_MODE=local)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_VERIFY_SSL=false

# --- Speech-to-Text & Diarization (AI4Bharat IndicWhisper / Vistaar) --------
ASR_PROVIDER=indic_whisper
FASTER_WHISPER_MODEL=large-v3-turbo
INDIC_WHISPER_MODEL=ai4bharat/whisper-medium-hi_alldata_multigpu
INDIC_ASR_LANGUAGE=auto
INDIC_ASR_PROMPT_BIASING=Doctor and patient clinical discussion in Indian English, Hinglish, and Tanglish. Common terms: Doctor, patient, clinic, hospital, fever, kaichal, bukhar, jwaram, cough, irumal, khansi, daggu, chest pain, nenju vali, chhati dard, headache, thalai vali, sar dard, breathlessness, moochu vida kashtam, sans lene me takleef, vomiting, ulti, dizziness, chakkar, BP, blood pressure, sugar, diabetes, tablet, syrup, mg, OD, BD, TDS, SOS, Dolo, Paracetamol, Glycomet, Metformin, Pantocid, Pan-D, Telma, Augmentin, Azithral, Crocin.

# Diarization: local acoustic clustering on CPU (zero cloud calls)
DIARIZATION_PROVIDER=local

# --- Database (Local SQLite) -----------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./medscribe_offline.db
ALLOW_SQLITE_FALLBACK=true
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./medscribe_offline.db

# --- Application -----------------------------------------------------------
APP_NAME=VoiceScribe AI (Gemma Offline Edition)
ENVIRONMENT=offline-local
LOG_LEVEL=INFO
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Simulation / Demo -----------------------------------------------------
ENABLE_DEMO_MODE=true
DEMO_SEGMENT_INTERVAL_SECONDS=2.5

# --- Audio -----------------------------------------------------------------
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_STORAGE_DIR=./storage/audio

# --- Security (Local Clinician Profile) -------------------------------------
DEV_AUTH_ENABLED=true
DEV_USER_EMAIL=doctor.gemma@voicescribe.local
DEV_USER_ROLE=DOCTOR
SECRET_KEY=offline-secret-key-voicescribe-gemma-secure
DATA_RETENTION_DAYS=365
